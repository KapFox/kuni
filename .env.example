# Kuni Configuration Environment Variables
# Copy this file to .env and adjust values as needed

# ===========================================
# LLM/Ollama Configuration
# ===========================================

# Enable local Ollama container (true/false)
# Set to false if using external LLM server
ENABLE_OLLAMA=true

# Use NVIDIA GPU for Ollama (true/false)
# Set to false if running on CPU or AMD GPU
OLLAMA_USE_NVIDIA_GPU=true

# Ollama model to pull on startup
# Examples: llama3:8b, qwen3.5:9b, gemma3:27b
OLLAMA_MODEL=qwen3.5:9b

# External LLM endpoint (if ENABLE_OLLAMA=false)
# Example: http://your-llm-server:11434/v1/
EXTERNAL_LLM_URL=

# External LLM bearer key (optional)
EXTERNAL_LLM_BEARER_KEY=

# ===========================================
# Stable Diffusion Configuration
# ===========================================

# Enable local Stable Diffusion container (true/false)
# Set to false if using external SD server
ENABLE_SD=true

# Use NVIDIA GPU for Stable Diffusion (true/false)
# Set to false if running on CPU or AMD GPU
SD_USE_NVIDIA_GPU=true

# External Stable Diffusion endpoint (if ENABLE_SD=false)
# Example: http://your-sd-server:7860/
EXTERNAL_SD_URL=

# ===========================================
# Resource Constraints (Optional)
# ===========================================

# GPU device IDs to use (comma-separated, or 'all')
# Leave empty to use all available GPUs
GPU_DEVICE_IDS=all

# Memory limit for containers (e.g., 8g, 16g)
# Leave empty for no limit
CONTAINER_MEMORY_LIMIT=
